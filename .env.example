# Local development only. Production secrets live in AWS Secrets Manager (SOP: Data protection).
DATABASE_URL=postgres://voiceai:voiceai@localhost:5432/voiceai
REDIS_URL=redis://localhost:6379

# Free self-hosted voices (see docs/POCKET_TTS.md)
POCKET_TTS_URL=http://127.0.0.1:8765

# Backup AI used only when AskG1 cannot answer (Llama 3.2 on llama.cpp, started by pnpm dev:stack)
LOCAL_LLM_URL=http://127.0.0.1:8090

# Phone line (Plivo). Leave empty until the carrier account and number exist (waiting on KYC).
# PUBLIC_BASE_URL is the public https address of the voice service (a tunnel in development); Plivo signs requests with it.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER=
PUBLIC_BASE_URL=
# Incoming calls run as this organisation and user (needs calls.place), speaking this voice and language.
PLIVO_ORG_ID=
PLIVO_AGENT_USER_ID=
PLIVO_VOICE=
PLIVO_LANGUAGE=en-hi
# The person's phone number a call is moved to when the caller asks for one.
PLIVO_HANDOFF_NUMBER=

{
  "name": "voice-ai-platform",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @voiceai/db generate",
    "db:migrate": "pnpm --filter @voiceai/db migrate",
    "db:seed": "pnpm --filter @voiceai/db seed",
    "db:seed-demo": "pnpm --filter @voiceai/db seed-demo",
    "demo:code": "pnpm --filter @voiceai/db demo:code",
    "dev:db": "bash packages/db/scripts/dev-db.sh",
    "dev:tts": "bash scripts/dev-tts.sh",
    "dev:stack": "bash scripts/dev-voice-stack.sh",
    "dev:voice": "bash scripts/dev-voice-service.sh",
    "dev:worker": "bash scripts/dev-worker.sh",
    "dev:voice-demo": "bash scripts/dev-voice-demo.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^7.0.2"
  }
}

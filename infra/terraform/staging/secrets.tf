# Generated by Terraform and kept in Secrets Manager (and so in Terraform state: keep the state bucket private and encrypted).
resource "random_password" "app_db" {
  length  = 32
  special = false
}

resource "random_password" "session" {
  length  = 48
  special = false
}

resource "random_password" "voice_token" {
  length  = 48
  special = false
}

resource "random_password" "voice_file" {
  length  = 48
  special = false
}

resource "random_id" "mfa_key" {
  byte_length = 32
}

resource "aws_secretsmanager_secret" "runtime" {
  name                    = "${var.name}/runtime"
  description             = "Generated: database login for the app, session and token secrets, MFA encryption key"
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "runtime" {
  secret_id = aws_secretsmanager_secret.runtime.id
  secret_string = jsonencode({
    DATABASE_URL       = "postgres://voiceai_app:${random_password.app_db.result}@${aws_db_instance.postgres.endpoint}/voiceai?sslmode=no-verify"
    APP_DB_PASSWORD    = random_password.app_db.result
    SESSION_SECRET     = random_password.session.result
    VOICE_TOKEN_SECRET = random_password.voice_token.result
    VOICE_FILE_SECRET  = random_password.voice_file.result
    MFA_ENCRYPTION_KEY = random_id.mfa_key.b64_std
  })
}

# Filled in by a person, never by Terraform: the container is created empty. Value is JSON with exactly these keys:
# DEEPGRAM_API_KEY, ELEVENLABS_API_KEY, ASKG1_API_KEY, PLIVO_AUTH_ID, PLIVO_AUTH_TOKEN (use a placeholder for any not used yet).
resource "aws_secretsmanager_secret" "providers" {
  name                    = "${var.name}/providers"
  description             = "Third-party keys, filled in by hand"
  recovery_window_in_days = 7
}
